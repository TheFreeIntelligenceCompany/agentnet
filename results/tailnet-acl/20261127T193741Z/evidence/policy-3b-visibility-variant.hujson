{
  // Throwaway Headscale policy for the AgentNet tailnet-ACL test.
  // Only tag:agentnet-client may reach tag:agentnet-relay on tcp/60000. Nothing else is allowed.
  "tagOwners": {
    "tag:agentnet-relay":  ["agentnet@"],
    "tag:agentnet-client": ["agentnet@"],
    "tag:agentnet-guest":  ["agentnet@"]
  },
  "acls": [
    {
      "action": "accept",
      "src": ["tag:agentnet-client"],
      "dst": ["tag:agentnet-relay:60000"]
    },
    {
      // variant 3b only: lets the guest see the relay peer (so the packet filter, not peer invisibility, is what is tested)
      "action": "accept",
      "src": ["tag:agentnet-guest"],
      "dst": ["tag:agentnet-relay:9999"]
    }
  ]
}
